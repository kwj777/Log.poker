# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Blog preview builds (npm run build:blog -- .preview)
.preview/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Netlify
.netlify/

# Audit scratch. An auditing agent proves a hypothesis by writing a probe and
# running it, and jest only collects from src/, so the probes have to live here
# rather than in a temp directory. They are throwaway by definition: the finding
# is the output, not the probe. Ignored so a half-finished audit never reads as
# uncommitted work.
src/__audit_*/
